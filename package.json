{
  "name": "@aspalagin/openclaw-yandex-search",
  "version": "0.2.3",
  "description": "Yandex + Brave web search for OpenClaw: both engines queried in parallel, results merged and deduplicated. Also ships a standalone Yandex Search API v2 provider.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "web-search",
    "yandex",
    "yandex-search",
    "brave",
    "brave-search",
    "multi-search",
    "search"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspalagin/openclaw-yandex-search.git"
  },
  "homepage": "https://github.com/aspalagin/openclaw-yandex-search#readme",
  "bugs": {
    "url": "https://github.com/aspalagin/openclaw-yandex-search/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --import tsx --test test/*.test.mjs",
    "smoke:multi": "node --import tsx ./scripts/smoke-multi.mjs",
    "smoke:yandex": "node --import tsx ./scripts/smoke-yandex.mjs"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.6",
      "minGatewayVersion": "2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6",
      "pluginSdkVersion": "2026.9.6"
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
